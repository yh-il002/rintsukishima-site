---
import { path, t, langs, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const ui = t(lang);
const langNames: Record<Lang, string> = { ja: '日本語', en: 'English' };
---

<header class="container site-header">
  <a href={path(lang)} class="logo">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"
      ><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path></svg
    >
    <span>Rin Tsukishima</span>
  </a>
  <nav aria-label={ui.navLabel}>
    <a href={path(lang, '/about/')}>Profile</a>
    <a href={`${path(lang)}#works`}>Works</a>
    <div class="lang-toggle" role="group" aria-label={ui.langGroupLabel}>
      {
        langs.map((l) =>
          l === lang ? (
            <span class="seg current" lang={l} aria-current="true" aria-label={langNames[l]}>
              {l.toUpperCase()}
            </span>
          ) : (
            <a class="seg" href={alternates[l]} hreflang={l} lang={l} aria-label={langNames[l]}>
              {l.toUpperCase()}
            </a>
          ),
        )
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    padding-block: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    letter-spacing: 0.12em;
  }
  nav {
    display: flex;
    gap: 32px;
    font-size: 15px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  nav {
    align-items: center;
  }
  nav > a { padding: 12px 0; }

  /* 言語トグル：現在の言語を塗りつぶしで示す */
  .lang-toggle {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    letter-spacing: 0.12em;
  }
  .seg {
    min-width: 44px;
    padding: 6px 12px 6px calc(12px + 0.12em);
    border-radius: 999px;
    text-align: center;
    line-height: 1;
    color: var(--mute);
    transition: background-color 0.2s, color 0.2s;
  }
  a.seg:hover { opacity: 1; color: var(--ink); background: #f2f2f2; }
  .seg.current { background: var(--ink); color: var(--paper); }
</style>
