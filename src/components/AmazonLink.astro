---
import ArrowIcon from './ArrowIcon.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  url?: string;
}
const { lang, url } = Astro.props;
const ui = t(lang);
---

{
  url ? (
    <a class="text-link" href={url} rel="noopener" target="_blank">
      {ui.readOnAmazon}
      <ArrowIcon />
    </a>
  ) : (
    <span class="text-link is-disabled">{ui.comingSoon}</span>
  )
}
