---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import { lead, type Book } from '../lib/books';
import { path, t, type Lang } from '../i18n/ui';

interface Props {
  book: Book;
  lang: Lang;
}
const { book, lang } = Astro.props;
const ui = t(lang);
const ed = book.data[lang];
const href = path(lang, `/books/${book.id}/`);
const otherTitle = lang === 'ja' ? book.data.en.title : book.data.ja.title;
---

<article class="card">
  <a href={href} class="cover" tabindex="-1" aria-hidden="true">
    <Image src={ed.cover} alt="" widths={[360, 540, 720]} sizes="(max-width: 640px) 100vw, 360px" />
  </a>
  <div class="meta">
    <p class="kicker">{book.data.year} — {book.data.genre[lang]}</p>
    <h3 class:list={[lang === 'ja' && 'mincho', lang]}><a href={href}>{ed.title}</a></h3>
    <p class="other-title" lang={lang === 'ja' ? 'en' : 'ja'}>{otherTitle}</p>
    <p class="lead">{lead(ed.description)}</p>
  </div>
  <a class="text-link" href={href}>{ui.details}<ArrowIcon /></a>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 24px; }
  .cover { display: block; border: 1px solid var(--line); }
  .cover:hover { opacity: 0.85; }
  .cover :global(img) { width: 100%; aspect-ratio: 5 / 8; object-fit: cover; }
  .meta { display: flex; flex-direction: column; gap: 10px; }
  .kicker { font-size: 14px; letter-spacing: 0.2em; color: var(--mute); }
  h3 { font-weight: 500; font-size: 24px; letter-spacing: 0.12em; }
  h3.en { font-weight: 400; font-style: italic; font-size: 28px; letter-spacing: 0.02em; }
  .other-title { font-size: 18px; font-style: italic; color: var(--mute); }
  .other-title:lang(ja) { font-family: var(--mincho); font-style: normal; font-size: 15px; letter-spacing: 0.08em; }
  .lead {
    margin-top: 8px;
    font-family: var(--mincho);
    font-size: 15px;
    line-height: 2;
    letter-spacing: 0.04em;
  }
  .lead:lang(en) { font-family: var(--latin); font-size: 18px; line-height: 1.7; letter-spacing: 0; }
</style>
