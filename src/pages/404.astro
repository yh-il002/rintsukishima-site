---
import Base from '../layouts/Base.astro';
---

<Base lang="ja" title="404" description="ページが見つかりませんでした。 / Page not found." alternates={{ ja: '/', en: '/en/' }}>
  <section class="section">
    <div class="container nf">
      <h1 lang="en">404</h1>
      <p class="mincho">ページが見つかりませんでした。</p>
      <p lang="en" class="mute">Page not found.</p>
      <p class="links"><a class="text-link" href="/">トップへ戻る</a> <a class="text-link" href="/en/" lang="en">Back to home</a></p>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: 120px 160px; display: flex; flex-direction: column; gap: 20px; }
  h1 { font-size: 96px; font-weight: 400; font-style: italic; line-height: 1; }
  .mincho { font-size: 18px; letter-spacing: 0.08em; }
  .mute { font-size: 20px; font-style: italic; }
  .links { display: flex; flex-wrap: wrap; gap: 32px; margin-top: 24px; }
</style>
